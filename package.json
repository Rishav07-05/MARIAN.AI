{
  "name": "marian-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MARIAN.AI — Fullstack Modular Workspace",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd $(git rev-parse --show-toplevel 2>/dev/null || echo .)/backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "test:backend": "cd $(git rev-parse --show-toplevel 2>/dev/null || echo .)/backend && PYTHONPATH=. pytest",
    "lint:backend": "cd $(git rev-parse --show-toplevel 2>/dev/null || echo .)/backend && ruff check ."
  }
}
